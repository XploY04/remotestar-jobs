# MongoDB. Include the database name in the URI.
DATABASE_URL=mongodb://localhost:27017/remotestar_candidate
# Used only by scripts/refresh_dev_data.py when copying public prod data to dev.
DATABASE_URL_DEV=mongodb://localhost:27017/remotestar_candidate_dev

# Job sources
RAPIDAPI_KEY=your_rapidapi_key
SERPAPI_KEY=your_serpapi_key

# OpenAI enrichment, query planning, embeddings, and match explanations
OPENAI_API_KEY=your_openai_api_key
ENABLE_AI_ENRICHMENT=true
ENABLE_QUERY_PLANNER=true
QUERY_PLANNER_MODEL=gpt-4o-mini
QUERY_PLANNER_MAX_QUERIES_PER_SOURCE=25
QUERY_PLANNER_POSTED_WITHIN_DAYS=15
QUERY_PLANNER_MAX_PAGES_PER_QUERY=5

# Pinecone job vectors
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=remotestar
PINECONE_NAMESPACE=jobs-pool

# On-demand matching worker
REDIS_URL=redis://localhost:6379/0

# Optional detail-page fetching
ENABLE_ATS_DETAIL_FETCH=true
ATS_DETAIL_MIN_DESCRIPTION=200

# API process
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
API_PORT=8000
