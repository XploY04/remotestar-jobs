# Database
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# API Keys
RAPIDAPI_KEY=your_rapidapi_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

OPENAI_API_KEY=your_openai_api_key
ENABLE_AI_ENRICHMENT=true

# Query Planner (OpenAI generates source search queries; fallback runs without it)
ENABLE_QUERY_PLANNER=true
QUERY_PLANNER_MODEL=gpt-4o-mini
QUERY_PLANNER_MAX_QUERIES_PER_SOURCE=25
QUERY_PLANNER_POSTED_WITHIN_DAYS=15
QUERY_PLANNER_MAX_PAGES_PER_QUERY=5

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
INGESTION_INTERVAL_MINUTES=30

# SerpAPI (for ATS company discovery)
SERPAPI_KEY=your_serpapi_key
